{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/sync/(.*)",
      "destination": "/api/sync/database.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|terminal\\.html|Control_De_Acceso_Web\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
