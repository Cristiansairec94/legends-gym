      "checkConstraints": {
        "sales_payment_status_allowed": {
          "name": "sales_payment_status_allowed",
          "value": "\"sales\".\"payment_status\" IN ('paid', 'pending')"
        },
        "sales_shift_context_valid": {
          "name": "sales_shift_context_valid",
          "value": "(\n        \"sales\".\"business_date\" IS NULL AND \"sales\".\"shift\" IS NULL\n      ) OR (\n        \"sales\".\"business_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n        AND \"sales\".\"shift\" IN ('am', 'pm')\n      )"
        },
        "sales_checkout_method_allowed": {
          "name": "sales_checkout_method_allowed",
          "value": "\"sales\".\"checkout_method\" IN ('efectivo', 'tarjeta', 'transferencia', 'pendiente', 'colaborador')"
        },
        "sales_payment_state_valid": {
          "name": "sales_payment_state_valid",
          "value": "(\n        \"sales\".\"payment_status\" = 'pending'\n        AND \"sales\".\"payment_method\" IS NULL\n        AND \"sales\".\"paid_at\" IS NULL\n        AND \"sales\".\"settlement_id\" IS NULL\n        AND (\n          (\n            \"sales\".\"checkout_method\" = 'pendiente'\n            AND \"sales\".\"debt_note\" IS NOT NULL\n            AND length(trim(\"sales\".\"debt_note\")) BETWEEN 1 AND 500\n            AND \"sales\".\"debtor_collaborator\" IS NULL\n          ) OR (\n            \"sales\".\"checkout_method\" = 'colaborador'\n            AND \"sales\".\"debtor_collaborator\" IS NOT NULL\n            AND length(trim(\"sales\".\"debtor_collaborator\")) BETWEEN 1 AND 100\n            AND (\n              \"sales\".\"debt_note\" IS NULL\n              OR length(trim(\"sales\".\"debt_note\")) BETWEEN 1 AND 500\n            )\n          )\n        )\n      ) OR (\n        \"sales\".\"payment_status\" = 'paid'\n        AND \"sales\".\"payment_method\" IS NOT NULL\n        AND \"sales\".\"payment_method\" IN ('efectivo', 'tarjeta', 'debito', 'credito', 'transferencia')\n        AND \"sales\".\"paid_at\" IS NOT NULL\n        AND (\n          (\n            \"sales\".\"checkout_method\" IN ('efectivo', 'tarjeta', 'transferencia')\n            AND \"sales\".\"debt_note\" IS NULL\n            AND \"sales\".\"debtor_collaborator\" IS NULL\n            AND \"sales\".\"settlement_id\" IS NULL\n          )\n          OR (\n            \"sales\".\"checkout_method\" = 'pendiente'\n            AND \"sales\".\"debt_note\" IS NOT NULL\n            AND length(trim(\"sales\".\"debt_note\")) BETWEEN 1 AND 500\n            AND \"sales\".\"debtor_collaborator\" IS NULL\n            AND \"sales\".\"settlement_id\" IS NOT NULL\n          )\n          OR (\n            \"sales\".\"checkout_method\" = 'colaborador'\n            AND \"sales\".\"debtor_collaborator\" IS NOT NULL\n            AND length(trim(\"sales\".\"debtor_collaborator\")) BETWEEN 1 AND 100\n            AND (\n              \"sales\".\"debt_note\" IS NULL\n              OR length(trim(\"sales\".\"debt_note\")) BETWEEN 1 AND 500\n            )\n            AND \"sales\".\"settlement_id\" IS NOT NULL\n          )\n        )\n      )"
        },
        "sales_total_clp_positive": {
          "name": "sales_total_clp_positive",
          "value": "\"sales\".\"total_clp\" > 0"
        }
