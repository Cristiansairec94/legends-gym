        "cash_closures_nonnegative": {
          "name": "cash_closures_nonnegative",
          "value": "\"cash_closures\".\"expected_cash_clp\" >= 0\n        AND \"cash_closures\".\"expected_card_clp\" >= 0\n        AND \"cash_closures\".\"expected_transfer_clp\" >= 0\n        AND \"cash_closures\".\"expected_collected_clp\" >= 0\n        AND \"cash_closures\".\"total_sales_clp\" >= 0\n        AND \"cash_closures\".\"sales_count\" >= 0\n        AND \"cash_closures\".\"pending_customer_clp\" >= 0\n        AND \"cash_closures\".\"collaborator_clp\" >= 0\n        AND \"cash_closures\".\"counted_cash_clp\" >= 0\n        AND \"cash_closures\".\"unassigned_sales_clp\" >= 0\n        AND \"cash_closures\".\"unassigned_sales_count\" >= 0\n        AND \"cash_closures\".\"unassigned_payments_clp\" >= 0\n        AND \"cash_closures\".\"unassigned_payments_count\" >= 0"
        },
        "cash_closures_collected_total_valid": {
          "name": "cash_closures_collected_total_valid",
          "value": "\"cash_closures\".\"expected_collected_clp\" = \"cash_closures\".\"expected_cash_clp\" + \"cash_closures\".\"expected_card_clp\" + \"cash_closures\".\"expected_transfer_clp\""
        },
        "cash_closures_difference_valid": {
          "name": "cash_closures_difference_valid",
          "value": "\"cash_closures\".\"difference_clp\" = \"cash_closures\".\"counted_cash_clp\" - \"cash_closures\".\"expected_cash_clp\""
        }
      }
