        "cash_closures_context_valid": {
          "name": "cash_closures_context_valid",
          "value": "\"cash_closures\".\"business_date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'\n        AND \"cash_closures\".\"shift\" IN ('am', 'pm')\n        AND length(trim(\"cash_closures\".\"responsible\")) BETWEEN 1 AND 100"
