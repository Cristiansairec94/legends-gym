# Demo Gym Ops — ejemplo sin credenciales reales.
# En local, copia solo lo necesario a .dev.vars (ignorado por Git).
# En stage/prod, configura estos valores como secretos del Worker (wrangler secret put).

# Autenticación HTTP Basic: SHA-256 hexadecimal de usuario:contraseña.
BASIC_AUTH_SHA256=
BASIC_AUTH_SALES_SHA256=

# URL pública canónica, sin slash final. Se usa en enlaces a incidencias.
APP_PUBLIC_URL=

# WhatsApp Cloud API. Mantener desactivado hasta completar credenciales,
# destinatarios con opt-in y plantillas aprobadas.
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Teléfonos E.164 separados por coma; se acepta + y se normaliza al enviar.
WHATSAPP_ADMIN_RECIPIENTS=

# Grupos oficiales: habilitar solo si la cuenta es OBA y los GROUP_ID fueron
# creados mediante la Groups API oficial. No usar IDs de grupos existentes.
WHATSAPP_GROUPS_ENABLED=false
WHATSAPP_GROUP_IDS=

# Nombres exactos de plantillas aprobadas como Utility.
WHATSAPP_ALERT_TEMPLATE_NAME=
# Opcional: si queda vacío, los recordatorios reutilizan la plantilla de alerta.
WHATSAPP_REMINDER_TEMPLATE_NAME=
WHATSAPP_DAILY_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_CL

# Límites admitidos: TTL 30–43200 segundos; reintentos 1–10.
WHATSAPP_UTILITY_TTL_SECONDS=3600
WHATSAPP_MAX_RETRIES=3
