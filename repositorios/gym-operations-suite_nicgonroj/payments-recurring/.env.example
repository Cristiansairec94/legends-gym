# Demo Gym · payments-recurring — variables de entorno de ejemplo (placeholders, nunca valores reales).
# Alternativa a config/private-environment.example.php. Solo sandbox: MP_CREDENTIAL_ENVIRONMENT=test
# exige APP_ENV=development, y el checkout permanece cerrado (DGYM_CHECKOUT_ENABLED=false) salvo en pruebas.

# Perfil de instalación/sandbox. Mantener gate false salvo durante una prueba controlada.
APP_ENV=development
DGYM_CHECKOUT_ENABLED=false
DGYM_PUBLIC_BASE_URL=https://demogym.example/inscripcion
DGYM_ENROLLMENT_URL=https://demogym.example/inscripcion/
DGYM_ALLOWED_ORIGIN=https://demogym.example
DGYM_DB_DSN=mysql:host=localhost;dbname=BASE_EJEMPLO;charset=utf8mb4
DGYM_DB_USER=USUARIO_EJEMPLO
DGYM_DB_PASSWORD=SECRETO_EN_HOSTING
# El token es opaco: el entorno se declara con procedencia del panel.
MP_API_TOKEN=CREDENCIAL_DE_PRUEBA_EN_HOSTING
MP_CREDENTIAL_ENVIRONMENT=test
MP_APPLICATION_ID=REEMPLAZAR_POR_ID_DE_APLICACION_NUMERICO
MP_SELLER_ID=REEMPLAZAR_POR_ID_NUMERICO
MP_WEBHOOK_SECRET=SECRETO_EN_HOSTING
# Khipu (transferencia para pago único y prepago). Apagado hasta contrato y pruebas; ver README.
DGYM_KHIPU_ENABLED=false
# Vigencia del enlace de transferencia, en horas (1 a 168).
DGYM_KHIPU_PAYMENT_EXPIRY_HOURS=24
KHIPU_API_KEY=CREDENCIAL_EN_HOSTING
KHIPU_MERCHANT_SECRET=SECRETO_EN_HOSTING
KHIPU_RECEIVER_ID=REEMPLAZAR_POR_ID_DE_CUENTA_DE_COBRO
# development = cuenta de cobro de desarrollo de Khipu; debe coincidir con APP_ENV.
KHIPU_CREDENTIAL_ENVIRONMENT=development
DGYM_ALLOWED_AUTOMATIC_DURATIONS=3,6,12
DGYM_ALLOWED_SINGLE_DURATIONS=1
DGYM_ALLOWED_PREPAID_DURATIONS=3,6,12
DGYM_PRICING_VERSION=2026-10-06-v4
DGYM_CONSENT_TEXT_VERSION=2026-09-21-v1
DGYM_RATE_LIMIT_SECRET=SECRETO_ALEATORIO_LARGO
# Compatibilidad legacy: esta versión ya no usa la identidad para bloquear inscripciones.
# Puede conservarse sin rotar durante el despliegue; no es requisito del checkout ni del preflight.
DGYM_IDENTITY_HMAC_SECRET_FILE=/RUTA/PRIVADA/dgym-identity-hmac.secret
# Compatibilidad alternativa: secreto directo de al menos 32 caracteres. No definir ambos.
# DGYM_IDENTITY_HMAC_SECRET=OTRO_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
DGYM_RATE_LIMIT_MAX=10
DGYM_RATE_LIMIT_WINDOW_SECONDS=900
# Retry: 12 solicitudes = 4 ciclos normales de 3 fases por inscripción/IP.
# El límite global admite 20 ciclos por IP y no consume el bucket del alta.
DGYM_PAYMENT_RETRY_RATE_LIMIT_MAX=12
DGYM_PAYMENT_RETRY_GLOBAL_RATE_LIMIT_MAX=60
DGYM_PAYMENT_RETRY_RATE_LIMIT_WINDOW_SECONDS=900
# Clave HMAC (base64url, 32 bytes) del panel operativo para conciliación manual firmada. Opcional.
DGYM_CONTROL_SYNC_KEY=
