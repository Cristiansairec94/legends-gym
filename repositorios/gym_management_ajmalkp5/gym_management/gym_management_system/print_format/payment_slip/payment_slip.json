 "html": "<style>\n\n    .receipt {\n        width: 700px;\n        margin: auto;\n        border: 1px solid #000;\n        padding: 20px;\n        font-family: Arial, sans-serif;\n        color: #000;\n    }\n\n    .header {\n        text-align: center;\n        margin-bottom: 20px;\n    }\n\n    .header h2 {\n        margin: 0;\n        font-size: 24px;\n    }\n\n    .header p {\n        margin: 2px 0;\n        font-size: 13px;\n    }\n\n    .title {\n        text-align: center;\n        font-size: 18px;\n        font-weight: bold;\n        margin-bottom: 20px;\n        border-top: 1px solid #000;\n        border-bottom: 1px solid #000;\n        padding: 8px 0;\n    }\n\n    .info-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 20px;\n    }\n\n    .info-table td {\n        padding: 8px;\n        /*border: 1px solid #000;*/\n        font-size: 13px;\n    }\n\n    .label {\n        font-weight: bold;\n        width: 35%;\n        /*background: #f2f2f2;*/\n    }\n\n    .amount-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 20px;\n    }\n\n    .amount-table th,\n    .amount-table td {\n        border: 1px solid #000;\n        padding: 20px;\n        text-align: center;\n        font-size: 13px;\n    }\n\n    .amount-table th {\n        background: #f2f2f2;\n    }\n\n    .status {\n        font-weight: bold;\n    }\n\n    .footer {\n        margin-top: 50px;\n    }\n\n    .signature {\n        width: 200px;\n        text-align: center;\n        float: right;\n    }\n\n    .signature-line {\n        margin-top: 50px;\n        border-top: 1px solid #000;\n        padding-top: 5px;\n        font-size: 13px;\n    }\n\n    .clearfix::after {\n        content: \"\";\n        display: block;\n        clear: both;\n    }\n\n</style>\n\n\n<div class=\"receipt\">\n\n    <div class=\"header\">\n        <h2>GYM PAYMENT RECEIPT</h2>\n        <p>Gym Management System</p>\n    </div>\n\n    <div class=\"title\">\n        PAYMENT RECEIPT\n    </div>\n\n    <table class=\"info-table\">\n\n        <tr>\n            <td class=\"label\">Receipt No</td>\n            <td>{{ doc.name }}</td>\n        </tr>\n\n        <tr>\n            <td class=\"label\">Member</td>\n            <td>{{ doc.member_name or doc.member }}</td>\n        </tr>\n\n        <tr>\n            <td class=\"label\">Membership</td>\n            <td>{{ doc.membership }}</td>\n        </tr>\n\n        <tr>\n            <td class=\"label\">Payment Date</td>\n            <td>{{ frappe.utils.formatdate(doc.payment_date) }}</td>\n        </tr>\n\n        <tr>\n            <td class=\"label\">Payment Mode</td>\n            <td>{{ doc.payment_mode }}</td>\n        </tr>\n\n        <tr>\n            <td class=\"label\">Status</td>\n            <td class=\"status\">{{ doc.status }}</td>\n        </tr>\n\n    </table>\n\n\n    <table class=\"amount-table\">\n\n        <thead>\n            <tr>\n                <th>Total Amount</th>\n                <th>Paid Amount</th>\n                <th>Outstanding Amount</th>\n            </tr>\n        </thead>\n\n        <tbody>\n            <tr>\n                <td>\u20b9 {{ doc.total_amount }}</td>\n                <td>\u20b9 {{ doc.paid_amount }}</td>\n                <td>\u20b9 {{ doc.outstanding_amount }}</td>\n            </tr>\n        </tbody>\n\n    </table>\n\n\n    <div class=\"footer clearfix\">\n\n        <div class=\"signature\">\n\n            <div class=\"signature-line\">\n                Authorized Signature\n            </div>\n\n        </div>\n\n    </div>\n\n</div>",
