{
  "name": "gym-management-backend",
  "version": "1.0.0",
  "description": "REST API for the International Body Building Club gym management & e-commerce system",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "psql \"$DATABASE_URL\" -f ../database/schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -f ../database/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
